{
  "name": "chrome-cookies-secure",
  "version": "3.0.2",
  "description": "Extract encrypted Google Chrome cookies for a url on a Mac, Linux or Windows",
  "types": "index.d.ts",
  "keywords": [
    "google",
    "chrome",
    "cookies",
    "encrypted",
    "curl",
    "decrypt",
    "encrypt",
    "extract"
  ],
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/index.test.js -t 5000",
    "test:e2e": "mocha tests/e2e.test.ts"
  },
  "author": "Bertrand Fan <bert@bert.org> (https://bert.org/), Reece Daniels <rubengmurray@gmail.com>",
  "license": "MIT",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bertrandom/chrome-cookies-secure.git"
  },
  "dependencies": {
    "int": "0.2.0",
    "sqlite3": "^6.0.1",
    "tldjs": "2.3.1",
    "tough-cookie": "5.1.2"
  },
  "optionalDependencies": {
    "keytar": "7.9.0",
    "win-dpapi": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/joi": "14.3.1",
    "@types/mocha": "^10.0.10",
    "joi": "14.3.1",
    "mocha": "^8.4.0",
    "playwright": "^1.61.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
