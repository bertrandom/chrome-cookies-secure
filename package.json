{
  "name": "chrome-cookies-secure",
  "version": "3.0.2",
  "description": "Extract encrypted Google Chrome cookies for a url on a Mac, Linux or Windows",
  "types": "index.d.ts",
  "keywords": [
    "google",
    "chrome",
    "cookies",
    "encrypted",
    "curl",
    "decrypt",
    "encrypt",
    "extract"
  ],
  "main": "index.js",
  "scripts": {
    "dprint:format": "dprint fmt --config dprint.json --config-discovery=ignore-descendants",
    "prepare": "husky install",
    "test": "mocha tests/index.test.js -t 5000",
    "test:e2e": "mocha tests/e2e.test.ts",
    "test:unit": "mocha tests/unit.test.js"
  },
  "author": "Bertrand Fan <bert@bert.org> (https://bert.org/), Reece Daniels <rubengmurray@gmail.com>",
  "license": "MIT",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bertrandom/chrome-cookies-secure.git"
  },
  "dependencies": {
    "int": "0.2.0",
    "sqlite3": "5.1.7",
    "tldjs": "2.3.1",
    "tough-cookie": "5.1.2"
  },
  "optionalDependencies": {
    "keytar": "7.9.0",
    "win-dpapi": "1.1.0"
  },
  "devDependencies": {
    "@dprint/typescript": "0.96.1",
    "@playwright/test": "1.61.1",
    "@types/joi": "14.3.1",
    "dprint": "0.54.0",
    "husky": "8.0.2",
    "joi": "14.3.1",
    "lint-staged": "13.1.0",
    "mocha": "8.4.0",
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=12.18.4"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "dprint fmt --config dprint.json --config-discovery=ignore-descendants --allow-no-files"
    ]
  }
}
